# Succenergy AI Coach — backend environment.
# Names only. Never commit real values; production values come from
# Google Secret Manager or the Cloud Run service configuration.

# --- Runtime ---------------------------------------------------------------
NODE_ENV=
# Cloud Run injects PORT itself. Locally use anything but 8080, which the
# Firestore emulator holds; 8787 is what the README and scripts assume.
PORT=

# --- Google Cloud / Firebase ----------------------------------------------
GCP_PROJECT_ID=
FIREBASE_PROJECT_ID=

# --- HTTP ------------------------------------------------------------------
# Comma-separated list of allowed browser origins. Ignored for native clients.
CORS_ALLOWED_ORIGINS=

# --- Logging ---------------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=

# --- Local emulators -------------------------------------------------------
# Set both to run against the Firebase Local Emulator Suite.
# Leave BOTH blank/absent in production so Application Default Credentials
# are used instead. Setting only one is rejected at boot.
FIRESTORE_EMULATOR_HOST=
FIREBASE_AUTH_EMULATOR_HOST=

# --- Test user for scripts/get_test_token.ts (emulator only) ---------------
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
