# Succenergy AI Coach — backend environment.
# Names only. Never commit real values; production values come from
# Google Secret Manager or the Cloud Run service configuration.

# --- Runtime ---------------------------------------------------------------
NODE_ENV=
# Cloud Run injects PORT itself. Locally, 8787 is what the README and the
# scripts assume.
PORT=

# --- Database --------------------------------------------------------------
# Postgres connection string. Required outside production; must be ABSENT in
# production, where it is read from Secret Manager instead so the credential
# is not sitting in the Cloud Run service configuration.
#
# Supabase: use the TRANSACTION POOLER string, port 6543. The direct
# connection is IPv6-only and Cloud Run egresses over IPv4.
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# Local Docker:
#   postgresql://postgres:postgres@127.0.0.1:5432/succenergy
DATABASE_URL=

# --- Google Cloud / Firebase ----------------------------------------------
GCP_PROJECT_ID=
FIREBASE_PROJECT_ID=

# --- HTTP ------------------------------------------------------------------
# Comma-separated list of allowed browser origins. Ignored for native clients.
CORS_ALLOWED_ORIGINS=

# --- Logging ---------------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=

# --- Local emulator --------------------------------------------------------
# Set to run against the Firebase Auth emulator. Firebase Auth is the only
# Firebase service this backend uses; there is no Firestore any more, and
# Postgres is simply a different DATABASE_URL.
# Must be ABSENT in production.
FIREBASE_AUTH_EMULATOR_HOST=

# --- Test user for scripts/get_test_token.ts (emulator only) ---------------
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
