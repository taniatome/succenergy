rules_version = '2';

// Deny-all. The mobile app never reads or writes Firestore directly; it
// reaches data only through the API, which uses the Admin SDK and therefore
// bypasses these rules. Anything a client can reach here is a mistake.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
